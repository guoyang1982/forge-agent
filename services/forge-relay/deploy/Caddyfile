{$FORGE_RELAY_DOMAIN} {
    encode zstd gzip

    reverse_proxy relay:8080 {
        transport http {
            versions 1.1
            read_timeout 120s
            write_timeout 120s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
