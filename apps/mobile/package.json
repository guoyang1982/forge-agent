{
  "name": "@forge/mobile",
  "version": "0.2.12",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --clear",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "tsc --noEmit",
    "pack:android": "bash ../../scripts/pack-mobile-android.sh",
    "eas:init": "eas init",
    "eas:build:preview": "eas build --platform android --profile preview",
    "eas-build-post-install": "cd ../.. && pnpm --filter @forge/mobile-crypto --filter @forge/mobile-protocol run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/mobile-crypto": "workspace:*",
    "@forge/mobile-protocol": "workspace:*",
    "@siteed/audio-studio": "^3.2.1",
    "expo": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sherpa-onnx": "^0.0.8",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "eas-cli": "^16.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.9"
  }
}
