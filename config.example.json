    "network": {
      "enabled": true,
      "search": "allow",
      "web": "allow",
      "api": "confirm",
      "download": "confirm",
      "allowedHosts": [],
      "searchMode": "live",
      "fetchMaxBytes": 2000000,
      "fetchTimeoutMs": 15000
