{
  "id": "computer-use",
  "name": "Forge Computer Use",
  "version": "1.1.4",
  "description": "Forge-owned macOS desktop automation with accessibility snapshots, element actions, target-app screenshots, keyboard, pointer, drag, and scroll control without requiring Codex.",
  "publisher": "forge",
  "enabledByDefault": true,
  "capabilities": {
    "skills": ["skills/computer-use.md"],
    "mcpServers": [
      {
        "name": "computer-use",
        "command": "node",
        "args": ["mcp/server.mjs"],
        "enabled": true
      }
    ]
  },
  "settings": {
    "required": ["macOS Accessibility", "macOS Screen Recording"],
    "schema": {
      "computerUse.enabled": {
        "type": "boolean",
        "description": "Enable Forge-owned desktop automation."
      }
    }
  }
}
